{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend API",
      "runtimeExecutable": "node",
      "runtimeArgs": ["src/server.js"],
      "port": 3000,
      "autoPort": false,
      "cwd": "gestionale/backend"
    },
    {
      "name": "Frontend Next.js",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "autoPort": false,
      "cwd": "gestionale/frontend"
    },
    {
      "name": "Scanner Service",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 5001,
      "cwd": "scanner-service"
    }
  ]
}
