SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE=YOUR_SUPABASE_SERVICE_ROLE_KEY
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_COOLDOWN_SECONDS=900
PORTAL_USERNAME=
PORTAL_PASSWORD=
PORTAL_PIN=
PORT=3000
ENGINE_AUTO_START=false
ENGINE_AUTO_INTERVAL_SECONDS=30
JWT_SECRET=change-me-in-production
AUTH_REQUIRED=false
MULTI_AUTOSCUOLA=false

# Google Calendar (OAuth2) – opzionale
# Crea progetto su https://console.cloud.google.com → API & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
# URL frontend per redirect post-OAuth
FRONTEND_URL=http://localhost:3001

# === Cron sync archivio storico portale (opt-in) ===
# Quando abilitato (=true) all'avvio del backend parte uno scheduler in-process
# (node-cron) con 3 job: incrementale (default ogni 5min, ultimi 7gg, solo
# rinnovi), daily (default 03:15, ultimi 90gg, tutto + Strategia A), weekly
# (default Domenica 02:30, full storico dal 2000-01-01).
# Lasciare false in dev locale per non saturare la sessione portale.
ARCHIVIO_SCHEDULER_ENABLED=false
# Override schedule (cron expressions standard). Lasciare vuoto per default.
ARCHIVIO_SYNC_INCREMENTAL_MIN=5
ARCHIVIO_SYNC_DAILY_HOUR=3
ARCHIVIO_SYNC_WEEKLY_HOUR=2
# Finestra temporale (giorni indietro) usata dal job incrementale.
ARCHIVIO_SYNC_WINDOW_DAYS=180
